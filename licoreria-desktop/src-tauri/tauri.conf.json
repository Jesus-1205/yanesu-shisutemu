{
  "productName": "Yanesu Shisutemu",
  "version": "1.0.0",
  "identifier": "com.yanesu.shisutemu",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yanesu Shisutemu",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Cargando",
        "width": 500,
        "height": 400,
        "decorations": false,
        "resizable": false,
        "visible": true,
        "center": true,
        "shadow": false,
        "url": "/splash.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../../backend/dist/yanesu_shisutemu"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "../windows/hooks.nsh"
      }
    }
  }
}
