# Copiar como .env y ajustar los valores antes de `docker compose up -d`.

# PostgreSQL (POSTGRES_PASSWORD debe ser URL-safe: sin @ : / ? #)
POSTGRES_USER=yanesu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=licoreria

# Seguridad. Si se migran datos desde el desktop, deben coincidir con el origen:
#   SECRET_KEY -> backend/.secret_key (AppData/Local/YanesuShisutemu)
#   ENCRYPTION_KEY -> la usada para cifrar SystemSetting (API key Gemini)
SECRET_KEY=change-me
ENCRYPTION_KEY=

# Cookie httpOnly con Secure. true solo si hay HTTPS delante.
SECURE_COOKIE=true

# Origenes permitidos por CORS (si el frontend se sirve por el mismo nginx, no se requiere).
CORS_ORIGINS=https://tu-dominio.com

GEMINI_API_KEY=
