# Backend - Yanesu Shisutemu
# Copiar como .env y ajustar valores.

# ── Seguridad ──
# SECRET_KEY: si no se define, se genera automáticamente y se guarda en
# %LOCALAPPDATA%/YanesuShisutemu/.secret_key (desktop) o se debe definir aquí (VPS/Docker).
# SECRET_KEY=

# ENCRYPTION_KEY: usada para cifrar SystemSetting (API key Gemini, etc.).
# Si se deja vacía, se deriva de SECRET_KEY via SHA-256.
# ENCRYPTION_KEY=

# Cookie httpOnly con flag Secure.
# true  → solo se envía por HTTPS (producción / VPS con nginx+TLS).
# false → se envía también por HTTP (desarrollo local / red local sin TLS).
# SECURE_COOKIE=true

# ── Base de datos ──
# Si DATABASE_URL no está definida, usa SQLite en %LOCALAPPDATA%/YanesuShisutemu/data/yanesu.db.
# Para PostgreSQL (VPS/Docker):
# DATABASE_URL=postgresql+psycopg://yanesu:change-me@localhost:5432/licoreria
# DATABASE_PATH=./licoreria.db

# ── CORS ──
# Orígenes permitidos separados por coma.
# CORS_ORIGINS=http://localhost:5173

# ── Integraciones ──
# GEMINI_API_KEY=
